# Language-specific rules will be added once the tech stack is chosen.

# Environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
secrets.*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editors and IDEs
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Logs and temporary files
*.log
logs/
tmp/
temp/

# Build output and dependencies (generic)
build/
dist/
out/
bin/
obj/
node_modules/
__pycache__/
.venv/
venv/
coverage/

# Python (backend)
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Node / React / extension
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*
.vite/
*.crx
*.zip

# Supabase local
supabase/.branches/
supabase/.temp/

# Playwright
test-results/
playwright-report/
