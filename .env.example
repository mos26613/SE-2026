# Copy this file to .env and fill in real values. Never commit .env.
PORT=8000
ENVIRONMENT=development

# Supabase (Settings -> API in the Supabase dashboard). Use the anon/public key, never service_role.
# While SUPABASE_URL is left as the placeholder, the backend runs in dev mode (in-memory data, no login).
SUPABASE_URL=your-supabase-url-here
SUPABASE_KEY=your-supabase-key-here

# Gemini (see backend/README.md, "Getting a Gemini API key").
# Leave GEMINI_API_KEY empty to run without the AI step; tasks are still saved.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_SECONDS=60

# Dashboard (frontend/). Vite only passes VITE_* values to the browser, so these must be
# public: the same Supabase URL and anon key as above, and where the backend runs.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=your-supabase-url-here
VITE_SUPABASE_ANON_KEY=your-supabase-key-here

# Browser origins allowed to call the API (the dashboard). Chrome extensions are always allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Where the link in the verification email sends a new student. Leave empty to use the Supabase "Site URL".
# Any other address must also be added under Redirect URLs in the Supabase dashboard.
FRONTEND_URL=
